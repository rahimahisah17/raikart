# ==========================================================
# Raikart — Environment Template
# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real secrets.
# This file contains placeholders ONLY.
# ==========================================================

# --- Server ---
PORT=3001

# --- Cloudinary (image storage; server-side only) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Admin allowlist (comma-separated emails) ---
ADMIN_EMAILS=you@example.com
VITE_ADMIN_EMAILS=you@example.com

# --- Firebase (auth only) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- Google Sign-In (Google Identity Services) ---
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Firebase Admin SDK (server only) ---
# Point this at a service-account JSON file that stays OUT of git.
GOOGLE_APPLICATION_CREDENTIALS=server/firebase-service-account.json

# --- Paystack ---
# Public key is safe in the browser; the secret key is SERVER-ONLY.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
